{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@dashboard-link/shared": ["../shared/src"],
      "@dashboard-link/database": ["../database/src"],
      "@dashboard-link/sms": ["../sms/src"],
      "@dashboard-link/tokens": ["../tokens/src"],
      "@dashboard-link/auth": ["../auth/src"],
      "@dashboard-link/plugins": ["../plugins/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
