{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "js/ts.preferences.importModuleSpecifier": "relative",
  "js/ts.suggest.autoImports": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "vitest.maximumConfigs": 20,
  "vitest.workspaceConfig": "./apps/admin/vitest.workspace.ts",
  "vitest.configSearchPatternExclude": "{**/node_modules/**,**/vendor/**,**/.*/**,**/*.d.ts,**/vite.config.*,**/*.timestamp-*.mjs}",
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/.next": true,
    "**/*.tsbuildinfo": true,
    "**/*.timestamp-*.mjs": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/.next": true,
    "**/*.timestamp-*.mjs": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.turbo/**": true,
    "**/coverage/**": true,
    "**/*.timestamp-*.mjs": true
  },
  "testing.automaticallyOpenPeekView": "failureInVisibleDocument",
  "testing.followRunningTest": true,
  "testing.gutterEnabled": true,
  "testing.showCoverageIndicator": true,
  "testExplorer.useNativeTesting": true,
  "testExplorer.useTestDiscovery": true,
  "testExplorer.exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/*.timestamp-*.mjs"
  ],
  "testExplorer.testMatch": [
    "**/*.{test,spec}.{js,jsx,ts,tsx}",
    "**/__tests__/**/*.{js,jsx,ts,tsx}"
  ],
  "cSpell.enabledSchemes": {
    "file": false
  }
}
