# === App URLs ===
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# === Node/Runtime ===
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# === JWT / Tokens ===
JWT_SECRET=replace-with-32+char-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=
TOKEN_PROVIDER=database
TOKEN_TABLE_NAME=tokens
TOKEN_DEFAULT_EXPIRY=3600
TOKEN_REFRESH_EXPIRY=2592000
TOKEN_CLEANUP_INTERVAL=3600
TOKEN_HASH=true
TOKEN_CLEANUP=true

# === Database (optional direct connection) ===
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DB_TYPE=supabase
DB_CACHE_ENABLED=true
DB_CACHE_TTL=300

# === Rate limiting / cache ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_CACHE=true
CACHE_TTL=300
ENABLE_ANALYTICS=false
EXTERNAL_API_TIMEOUT=30000

# === SMS Provider Selection ===
DEFAULT_SMS_PROVIDER=mobile-message
FALLBACK_SMS_PROVIDERS=twilio

# === MobileMessage SMS (Australia) ===
MOBILE_MESSAGE_USERNAME=your-username
MOBILE_MESSAGE_PASSWORD=your-password
MOBILE_MESSAGE_SENDER_ID=DashLink

# === Twilio SMS ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM=DashLink

# === AWS SNS SMS ===
AWS_SNS_ACCESS_KEY_ID=
AWS_SNS_SECRET_ACCESS_KEY=
AWS_SNS_REGION=us-east-1
AWS_SNS_SENDER_ID=DashLink

# === MessageBird SMS ===
MESSAGE_BIRD_API_KEY=
MESSAGE_BIRD_ORIGINATOR=DashLink

# === SMS API (generic) ===
SMS_API_KEY=
SMS_API_URL=

# === Plugin Credentials ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AIRTABLE_API_KEY=
NOTION_INTEGRATION_SECRET=

# Google Calendar is OAuth-first. Use API keys only for a separate public-calendars connector.

# === Redis (BullMQ queues) ===
REDIS_URL=

# === Observability ===
# Start with Sentry for errors; add Grafana Cloud for metrics/tracing later.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# === Billing (Stripe) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Vite Frontend Environment ===
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_JWT_SECRET=replace-with-32+char-secret
