# === Dashboard Link SaaS - Environment Configuration ===
# Copy this file to .env and fill in your values
# Minimum required variables are marked with **REQUIRED**
# === App URLs ===
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# === Node/Runtime ===
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# === Supabase ===
# Get these from your Supabase project settings or run `pnpm db:start` and `supabase status`
SUPABASE_URL=https://your-project.supabase.co **REQUIRED**
SUPABASE_ANON_KEY=your-anon-key **REQUIRED**
SUPABASE_SERVICE_KEY=your-service-key **REQUIRED**

# === JWT / Tokens ===
# Generate a secure 32+ character secret for production
JWT_SECRET=replace-with-32+char-secret **REQUIRED**
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=
TOKEN_PROVIDER=database
TOKEN_TABLE_NAME=tokens
TOKEN_DEFAULT_EXPIRY=3600
TOKEN_REFRESH_EXPIRY=2592000
TOKEN_CLEANUP_INTERVAL=3600
TOKEN_HASH=true
TOKEN_CLEANUP=true

# === Database (optional direct connection) ===
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DB_TYPE=supabase
DB_CACHE_ENABLED=true
DB_CACHE_TTL=300

# === Rate limiting / cache ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_CACHE=true
CACHE_TTL=300
ENABLE_ANALYTICS=false
EXTERNAL_API_TIMEOUT=30000

# === SMS Provider Selection ===
# MobileMessage is the default provider for Australian SMS
SMS_DEFAULT_PROVIDER=mobile-message
SMS_FALLBACK_PROVIDERS=twilio,aws-sns
SMS_ENABLE_DELIVERY_TRACKING=true

# === MobileMessage SMS (Australia) ===
# Use placeholders for local development
MOBILEMESSAGE_USERNAME=your-username
MOBILEMESSAGE_PASSWORD=your-password
MOBILEMESSAGE_SENDER_ID=DashLink

# === Twilio SMS ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === AWS SNS SMS ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=au-east-1

# === MessageBird SMS ===
MESSAGE_BIRD_API_KEY=
MESSAGE_BIRD_ORIGINATOR=DashLink

# === SMS API (generic) ===
SMS_API_KEY=
SMS_API_URL=

# === Plugin Credentials ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AIRTABLE_API_KEY=
NOTION_INTEGRATION_SECRET=

# Google Calendar is OAuth-first. Use API keys only for a separate public-calendars connector.

# === Redis (BullMQ queues) ===
REDIS_URL=

# === Observability ===
# Start with Sentry for errors; add Grafana Cloud for metrics/tracing later.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# === Billing (Stripe) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Vite Frontend Environment ===
# Copy these to apps/admin/.env and apps/worker/.env
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_JWT_SECRET=replace-with-32+char-secret

# === Quick Setup Checklist ===
# 1. Copy ENV.example to .env
# 2. Fill in SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_KEY
# 3. Generate a JWT_SECRET (32+ chars)
# 4. Copy VITE_* variables to apps/admin/.env and apps/worker/.env
# 5. Run `pnpm db:start` to start local Supabase
# 6. Run `pnpm dev` to start the API
